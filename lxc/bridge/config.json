{
  "listen": "127.0.0.1:8443",
  "upstream": "wss://uniproxy.alice.yandex.net/uni.ws",
  "mode": "hybrid",
  "listen_after_reply": true,
  "tls_cert": "",
  "tls_key": "",
  "allowed_ips": [
    "127.0.0.1",
    "::1"
  ],
  "local_progress": {
    "enabled": true
  },
  "dialogue_context": {
    "enabled": true
  },
  "conversation_log": {
    "enabled": true,
    "path": "/data/opt/quasar-bridge/conversations.jsonl",
    "max_size_mb": 2,
    "max_backups": 1,
    "max_text_chars": 4000
  },
  "routing": {
    "rules": [
      {
        "name": "speaker_playback",
        "route": "yandex",
        "match": {
          "regex": "^\\s*(?:алиса[,\\s]+)?(?:пожалуйста[,\\s]+)?(?:хватит|стоп|пауза|останови(?:те)?|(?:останови(?:те)?|выключи(?:те)?|прекрати(?:те)?) (?:музыку|воспроизведение|песню|песни|трек|радио)|поставь(?:те)? на паузу|(?:продолжи(?:те)?|возобнови(?:те)?) (?:музыку|воспроизведение|песню|трек))[,\\s]*(?:пожалуйста)?[.!?]*\\s*$"
        }
      },
      {
        "name": "playback_nav",
        "route": "llm",
        "match": {
          "contains_any": [
            "следующий трек",
            "следующую",
            "следующий",
            "следующее",
            "предыдущий",
            "предыдущую",
            "дальше",
            "назад"
          ]
        }
      },
      {
        "name": "home_devices",
        "route": "home",
        "match": {
          "contains_all_groups": [
            [
              "свет",
              "ламп",
              "люстр",
              "розетк",
              "штор",
              "кондиционер",
              "термостат",
              "обогрев",
              "вентилятор",
              "пылесос",
              "телевизор",
              "датчик",
              "замок",
              "кран",
              "конфорк",
              "увлажн"
            ],
            [
              "включ",
              "выключ",
              "открой",
              "закрой",
              "установ",
              "постав",
              "сделай",
              "состояни",
              "проверь",
              "горит",
              "работает"
            ]
          ],
          "contains_none": [
            "песню",
            "песни",
            "музыку",
            "радио",
            "трек"
          ]
        }
      },
      {
        "name": "device_commands",
        "route": "yandex",
        "match": {
          "contains_any": [
            "сказк",
            "подкаст",
            "громкость",
            "громче",
            "тише",
            "будильник",
            "таймер",
            "напомни",
            "новости"
          ]
        }
      },
      {
        "name": "music_requests",
        "route": "llm",
        "match": {
          "regex": "^\\s*(?:алиса[,\\s]+)?(?:пожалуйста[,\\s]+)?(?:поставь|проиграй|переключи)(?:\\s|$)|^\\s*(?:алиса[,\\s]+)?(?:пожалуйста[,\\s]+)?включи\\s+(?:песню|трек|музыку|композицию|альбом|плейлист|исполнителя|группу)(?:\\s|$)"
        }
      },
      {
        "name": "include_other",
        "route": "llm",
        "match": {
          "regex": "^\\s*(?:алиса[,\\s]+)?(?:пожалуйста[,\\s]+)?включи(?:\\s|$)"
        }
      }
    ],
    "default_route": "llm",
    "refusal": {
      "enabled": true,
      "prefixes": [
        "чтобы слушать",
        "чтобы включить",
        "для этого нужна",
        "оформите",
        "нужна подписка",
        "я попробовала",
        "не получилось",
        "нужно, чтобы",
        "это можно сделать",
        "я не смогла",
        "я не могу включить"
      ],
      "contains_any": [
        "подписк",
        "плюс"
      ]
    }
  }
}