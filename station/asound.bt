pcm.!default {
  type asym
  playback.pcm {
    type plug
    slave.pcm "bt_forced"
  }
  capture.pcm {
    type multi
    slaves.a.pcm "hw:0,1"
    slaves.a.channels 8
    slaves.b.pcm "hw:0,0"
    slaves.b.channels 2
    bindings.0.slave a
    bindings.0.channel 0
    bindings.1.slave a
    bindings.1.channel 2
    bindings.2.slave a
    bindings.2.channel 4
    bindings.3.slave a
    bindings.3.channel 6
    bindings.4.slave b
    bindings.4.channel 0
    bindings.5.slave b
    bindings.5.channel 1
  }
}

pcm.bt_forced {
  type plug
  slave {
    pcm {
      type bluealsa
      device "87:00:A9:BC:26:2A"
      profile "a2dp"
    }
    rate 48000
    format S16_LE
    channels 2
  }
}
